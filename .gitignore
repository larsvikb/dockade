__pycache__/
*.pyc
# Local GGUF weights for the llm-* compose profiles (large, host-local).
models/
# Fallback location for MCP client credentials when MCP_SECRETS is unset — only a
# hand-run `docker compose` lands here, since the Makefile exports the real path under
# ~/.config/dockade. Ignored because the real ones must NEVER be in this tree: it is
# bind-mounted read-write into the sandbox, so a token here is a token the agent holds.
secrets/
# Local compose overrides (DNS, model selection). Host-specific, never shared.
.env
# Container logs pulled into the tree for analysis (`docker logs llm-intel &>...`).
# Useful to read, never to commit: host-specific, large, and stale within minutes.
*.log
# Local review scratch pad (findings / todo). Working notes, not a repo artifact.
local-todo.md
# Fallback location for `make backup` output if BACKUP_DIR is pointed back into the
# tree by hand — the Makefile's default is under ~/.config/dockade, beside the MCP
# secrets and for the same reason. The crown-jewel store: every host the agent has
# asked for and the operator's whole policy, in a file `restore` will install. Never
# in this tree, because the tree is bind-mounted read-write into the sandbox.
backups/
# Claude Code's per-checkout state: agent worktrees (each one a second copy of this
# repo) and machine-local settings. The rest of .claude/ stays visible on purpose:
# committed skills and agents are reviewed like any other change, and
# tests/test_claude_config.py refuses anything else there. Why: DESIGN.md "Durable host
# config lives outside the repo".
.claude/worktrees/
.claude/settings.local.json
# Each checkout's note of what its branch is doing, for parallel sessions to read
# (CLAUDE.md, Conventions). One writer per file, so sessions never collide, and the
# note goes when its worktree does.
/inflight.md
